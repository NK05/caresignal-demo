# The API reads the workspace-root .env.local by default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_TIMEOUT_SECONDS=15
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEMO_PHONE_MAP={}
CARESIGNAL_ENV=development
CARESIGNAL_DATABASE_URL=sqlite:///./caresignal.db
CARESIGNAL_CORS_ORIGINS=http://localhost:3000
CARESIGNAL_AUTO_BOOTSTRAP=true
CARESIGNAL_DEMO_RESET_ENABLED=true
CARESIGNAL_DEMO_RESET_TOKEN=replace-with-a-random-local-token
CARESIGNAL_BP_SYSTOLIC_MIN=40
CARESIGNAL_BP_SYSTOLIC_MAX=300
CARESIGNAL_BP_DIASTOLIC_MIN=20
CARESIGNAL_BP_DIASTOLIC_MAX=200
